{
  "name": Python 3 Project",
  "image": "mcr.microsoft.com/devcontainers/python:3",
  "postCreateCommand": "pip3 install pandas requests",
  "postCreateCommand": "pip3 install matlibplot requests",
  "postCreateCommand": "pip3 install numpy requests",
  "postCreateCommand": "pip3 install scipy requests"
  }
{
  "name": "Cantera Development Environment",
  "image": "://microsoft.com",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "conda create -y -n cantera -c conda-forge cantera ipython numpy scipy matplotlib jupyterlab"
}
{
  "name": "Python Projekt mit .venv",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvInModifiedTerminal": true,
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  },
  "postCreateCommand": "conda init bash && eval \"$(conda shell.bash hook)\" && conda deactivate && python3 -m venv .venv && source .venv/bin/activate && pip install --upgrade pip ipykernel && python -m ipykernel install --user --name=projekt-venv --display-name \"Python (.venv)\""
}
{
  "name": "Codespace with bwSync&Share",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "postCreateCommand": "bash .devcontainer/install-bwsas.sh",

  "postStartCommand": "bash .devcontainer/start-bwsas.sh"
}
