{
  "name": "Cantera Development Environment",
  "image": "://microsoft.com",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "conda create -y -n cantera -c conda-forge cantera ipython matplotlib jupyterlab"
}

{
  "name": "Codespace with bwSync&Share",

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "postCreateCommand": "bash .devcontainer/install-bwsas.sh",

  "postStartCommand": "bash .devcontainer/start-bwsas.sh"
}
