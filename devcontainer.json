{
  "name": "bwsyncandshare",
  
  // 1. Die Secrets aus GitHub anfordern
  "secrets": {
    "NC_URL": {},
    "NC_USER": {},
    "NC_PASS": {}
  },

  // 2. Secrets in globale Umgebungsvariablen umwandeln
   "remoteEnv": {
    "NC_URL": "${localEnv:NC_URL}",
    "NC_USER": "${localEnv:NC_USER}",
    "NC_PASS": "${localEnv:NC_PASS}"
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "configureZshAsDefaultShell": false
    }
  },

  // postStartCommand WIRD ENTFERNT UND DURCH postAttachCommand ERSETZT:
  "postAttachCommand": "~/mount-cloud.sh"
}
